<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenSweep</AssemblyName>
    <RootNamespace>OpenSweep</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>OpenSweep</Product>
    <Description>Limpiador y desinstalador para Windows</Description>
    <Copyright>OpenSweep</Copyright>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
