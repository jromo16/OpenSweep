<!-- Paleta oscura (inspirada en macOS) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ContentBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#38383A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#98989D"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#0B8A5F"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavSelectionBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TileBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="InputBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2234D399"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#0B3B2C"/>
    <SolidColorBrush x:Key="BannerTextBrush" Color="#B7F5DC"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
</ResourceDictionary>
