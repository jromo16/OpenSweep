<!-- Paleta clara (inspirada en macOS) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ContentBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E8E8ED"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E3E8"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2410B981"/>
    <SolidColorBrush x:Key="NavSelectionBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="TileBrush" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#059669"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A10B981"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="BannerTextBrush" Color="#065F46"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D97706"/>
</ResourceDictionary>
