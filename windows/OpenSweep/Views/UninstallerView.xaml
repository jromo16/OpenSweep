<UserControl x:Class="OpenSweep.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Desinstalador" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Desinstala programas y elimina los restos que dejan (carpetas, archivos y claves del registro). Usa la desinstalación forzada para programas rotos o parcialmente desinstalados." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <TabControl>
            <!-- ================= Programas ================= -->
            <TabItem Header="Programas instalados">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <CheckBox x:Name="ShowSystem" Content="Mostrar componentes del sistema" VerticalAlignment="Center" Margin="0,0,12,0" Click="Refresh_Click"/>
                            <Button Content="Actualizar" Click="Refresh_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="SearchBox" Width="320" TextChanged="Search_Changed" ToolTip="Buscar por nombre o fabricante"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Abrir carpeta" Click="OpenFolder_Click"/>
                            <Button Content="Ver en el registro" Margin="6,0,0,0" Click="OpenRegistry_Click"/>
                            <Button Content="Buscar en Internet" Margin="6,0,0,0" Click="SearchWeb_Click"/>
                            <Button Content="Desinstalación forzada" Margin="6,0,0,0" Click="Forced_Click"/>
                            <Button x:Name="UninstallBtn" Content="Desinstalar" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Uninstall_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="ProgramsGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="ProgramsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="*"/>
                                <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="110"/>
                                <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="90"/>
                                <DataGridTextColumn Header="Instalado" Binding="{Binding DateText}" SortMemberPath="InstallDate" Width="95"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Arch}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Apps de Windows ================= -->
            <TabItem Header="Apps de Windows (Store)">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock x:Name="StoreCountText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cargar / actualizar" Click="LoadStore_Click"/>
                            <Button x:Name="RemoveStoreBtn" Content="Desinstalar seleccionadas" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="RemoveStore_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="StoreGrid">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                <DataGridTextColumn Header="Aplicación" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="120" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar x:Name="StoreBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Desinstalación forzada ================= -->
            <TabItem Header="Desinstalación forzada">
                <StackPanel Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                               Text="Para programas que no aparecen en la lista o cuyo desinstalador falla. Escribe el nombre exacto del programa y, opcionalmente, la carpeta donde estaba instalado. OpenSweep buscará y eliminará sus restos."/>
                    <TextBlock Text="Nombre del programa" Margin="0,0,0,4"/>
                    <TextBox x:Name="ForcedName"/>
                    <TextBlock Text="Carpeta de instalación (opcional)" Margin="0,12,0,4"/>
                    <DockPanel>
                        <Button Content="Examinar..." DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseForced_Click"/>
                        <TextBox x:Name="ForcedFolder"/>
                    </DockPanel>
                    <Button Content="Buscar restos" Padding="20,8" Margin="0,16,0,0" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}" Click="ForcedScan_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
