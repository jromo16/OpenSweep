<UserControl x:Class="OpenSweep.Views.RegistryCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Limpiador del registro" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Busca entradas del registro que apuntan a archivos o programas que ya no existen. Antes de reparar se guarda una copia de seguridad (.reg) para poder deshacer los cambios." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Buscar problemas en" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="CategoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Abrir carpeta de copias" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OpenBackups_Click"/>
                </StackPanel>
            </Border>
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SummaryTitle" Text="Listo para buscar problemas" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Text="Pulsa «Buscar problemas»."/>
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Marcar todo" Click="CheckAll_Click"/>
                        <Button Content="Desmarcar todo" Margin="6,0,0,0" Click="UncheckAll_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ScanBtn" Content="Buscar problemas" Padding="20,8" Click="Scan_Click"/>
                        <Button x:Name="FixBtn" Content="Reparar seleccionados" Padding="20,8" Margin="8,0,0,0" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="Fix_Click"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="IssuesGrid">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="Problema" Binding="{Binding Problem}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Datos" Binding="{Binding Data}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Clave del registro" Binding="{Binding Entry}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="6,8,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
