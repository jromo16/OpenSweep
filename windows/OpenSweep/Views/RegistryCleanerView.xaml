<UserControl x:Class="OpenSweep.Views.RegistryCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Limpiador del registro'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Busca entradas del registro que apuntan a archivos o programas que ya no existen. Antes de reparar se guarda una copia de seguridad (.reg) para poder deshacer los cambios.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Buscar problemas en'}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="CategoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding NameText}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:T 'Abrir carpeta de copias'}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OpenBackups_Click"/>
                </StackPanel>
            </Border>
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SummaryTitle" Text="{l:T 'Listo para buscar problemas'}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Text="{l:T 'Pulsa «Buscar problemas».'}"/>
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T 'Marcar todo'}" Click="CheckAll_Click"/>
                        <Button Content="{l:T 'Desmarcar todo'}" Margin="6,0,0,0" Click="UncheckAll_Click"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="ScanBtn" Content="{l:T 'Buscar problemas'}" Padding="20,8" Click="Scan_Click"/>
                        <Button x:Name="FixBtn" Content="{l:T 'Reparar seleccionados'}" Padding="20,8" Margin="8,0,0,0" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="Fix_Click"/>
                    </WrapPanel>
                </DockPanel>
                <DataGrid x:Name="IssuesGrid">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="52"
                                        ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}"/>
                        <DataGridTextColumn Header="{l:T 'Problema'}" Binding="{Binding ProblemText}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{l:T 'Datos'}" Binding="{Binding Data}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{l:T 'Clave del registro'}" Binding="{Binding Entry}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="6,8,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
