<UserControl x:Class="OpenSweep.Views.UpdaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Actualizar programas'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Busca versiones nuevas de tus programas e instálalas de forma silenciosa usando el Administrador de paquetes de Windows (winget). Mantener los programas al día corrige fallos de seguridad.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CheckBtn" Content="{l:T 'Buscar actualizaciones'}" Click="Check_Click"/>
                <Button x:Name="UpdateBtn" Content="{l:T 'Actualizar seleccionados'}" Padding="20,6" Margin="6,0,0,0" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" Click="Update_Click"/>
            </WrapPanel>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="UpdatesGrid">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                    <DataGridTextColumn Header="{l:T 'Programa'}" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{l:T 'Id'}" Binding="{Binding Id}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{l:T 'Instalada'}" Binding="{Binding Current}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{l:T 'Disponible'}" Binding="{Binding Available}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{l:T 'Estado'}" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
