<UserControl x:Class="OpenSweep.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Copias de seguridad'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Deshaz cualquier cambio: restaura las copias del registro que OpenSweep guarda antes de reparar o desinstalar, o vuelve a un punto de restauración del sistema.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="16"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{l:T 'Copias del registro'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="{l:T 'Abrir carpeta'}" Click="OpenFolder_Click"/>
                        <Button Content="{l:T 'Eliminar'}" Margin="6,0,0,0" Click="DeleteReg_Click"/>
                        <Button Content="{l:T 'Restaurar'}" Padding="18,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="RestoreReg_Click"/>
                    </WrapPanel>
                </DockPanel>
                <DataGrid x:Name="RegGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Fecha'}" Binding="{Binding DateText}" Width="160"/>
                        <DataGridTextColumn Header="{l:T 'Archivo'}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{l:T 'Tamaño'}" Binding="{Binding SizeText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{l:T 'Puntos de restauración del sistema'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="CreateBtn" Content="{l:T 'Crear punto ahora'}" Click="CreatePoint_Click"/>
                        <Button Content="{l:T 'Abrir Restaurar sistema'}" Padding="18,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OpenRstrui_Click"/>
                    </WrapPanel>
                </DockPanel>
                <TextBlock x:Name="PointsStatus" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <DataGrid x:Name="PointsGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Fecha'}" Binding="{Binding Date}" Width="160"/>
                        <DataGridTextColumn Header="{l:T 'Descripción'}" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="N.º" Binding="{Binding SequenceNumber}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
