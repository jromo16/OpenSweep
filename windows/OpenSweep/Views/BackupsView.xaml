<UserControl x:Class="OpenSweep.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Copias de seguridad" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Deshaz cualquier cambio: restaura las copias del registro que OpenSweep guarda antes de reparar o desinstalar, o vuelve a un punto de restauración del sistema." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="16"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Copias del registro" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Abrir carpeta" Click="OpenFolder_Click"/>
                        <Button Content="Eliminar" Margin="6,0,0,0" Click="DeleteReg_Click"/>
                        <Button Content="Restaurar" Padding="18,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="RestoreReg_Click"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="RegGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="160"/>
                        <DataGridTextColumn Header="Archivo" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Puntos de restauración del sistema" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CreateBtn" Content="Crear punto ahora" Click="CreatePoint_Click"/>
                        <Button Content="Abrir Restaurar sistema" Padding="18,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OpenRstrui_Click"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="PointsStatus" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <DataGrid x:Name="PointsGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="160"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="N.º" Binding="{Binding SequenceNumber}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
