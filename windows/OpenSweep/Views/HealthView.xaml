<UserControl x:Class="OpenSweep.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{l:T 'Panel de salud'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Analiza tu PC en un clic: archivos basura, problemas del registro y programas que ralentizan el arranque.'}" Style="{StaticResource PageSubtitle}"/>

            <!-- Resumen del equipo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="OsText" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="DrivesList" Grid.Column="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Resultado del análisis -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="ScanBtn" Content="{l:T 'Analizar PC'}" Padding="18,8" Click="Scan_Click"/>
                            <Button x:Name="FixBtn" Content="{l:T 'Mejorarlo ahora'}" Padding="18,8" Margin="8,0,0,0" IsEnabled="False"
                                    Style="{DynamicResource AccentButtonStyle}" Click="Fix_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="ScoreTitle" Text="{l:T 'Aún no se ha analizado'}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScoreSub" Text="{l:T 'Pulsa «Analizar PC» para comprobar el estado del equipo.'}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

                    <UniformGrid Columns="3" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{l:T '&#xE74D;'}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{l:T 'Archivos basura'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="JunkText" Text="—" FontSize="20"/>
                                <TextBlock Text="{l:T 'Temporales, caché y papelera'}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{l:T '&#xE9F5;'}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{l:T 'Registro'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="RegText" Text="—" FontSize="20"/>
                                <TextBlock Text="{l:T 'Entradas inválidas u obsoletas'}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T '&#xE7B5;'}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{l:T 'Programas de inicio'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="StartupText" Text="—" FontSize="20"/>
                                <TextBlock Text="{l:T 'Se abren al iniciar Windows'}" Style="{StaticResource Muted}"/>
                                <Button Content="{l:T 'Administrar'}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Startup_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
