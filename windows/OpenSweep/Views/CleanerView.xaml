<UserControl x:Class="OpenSweep.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Limpieza personalizada'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Elige qué limpiar en Windows, navegadores y aplicaciones. Primero analiza para ver cuánto espacio se libera.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,6">
                        <Button Content="{l:T 'Todo'}" Padding="10,3" Click="SelectAll_Click"/>
                        <Button Content="{l:T 'Ninguno'}" Padding="10,3" Margin="6,0,0,0" Click="SelectNone_Click"/>
                        <Button Content="{l:T 'Recomendado'}" Padding="10,3" Margin="6,0,0,0" Click="SelectDefault_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GroupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                                        <ItemsControl ItemsSource="{Binding Sections}" Margin="8,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4,0,4">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                                                        <ItemsControl ItemsSource="{Binding Rules}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding DisplayName}" ToolTip="{Binding DisplayWarning}"
                                                                              Checked="Rule_Changed" Unchecked="Rule_Changed" Margin="0,1" MinHeight="26"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SummaryTitle" Text="{l:T 'Listo para analizar'}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Text="{l:T 'Selecciona elementos a la izquierda y pulsa «Analizar».'}" Style="{StaticResource Muted}"/>
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Maximum="100" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Padding="16,8" Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="AnalyzeBtn" Content="{l:T 'Analizar'}" Padding="20,8" Margin="8,0,0,0" Click="Analyze_Click"/>
                    <Button x:Name="CleanBtn" Content="{l:T 'Ejecutar limpieza'}" Padding="20,8" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Clean_Click"/>
                </StackPanel>
                <DataGrid x:Name="ResultsGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Elemento'}" Binding="{Binding Display}" Width="*"/>
                        <DataGridTextColumn Header="{l:T 'Archivos'}" Binding="{Binding Count, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="{l:T 'Tamaño'}" Binding="{Binding SizeText}" Width="110" SortMemberPath="Bytes"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
