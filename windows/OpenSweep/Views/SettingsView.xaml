<UserControl x:Class="OpenSweep.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{l:T 'Opciones'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Los cambios se guardan automáticamente.'}" Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Limpieza'}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="SecureDelete" Content="{l:T 'Borrado seguro al limpiar (más lento: sobrescribe los archivos antes de eliminarlos)'}" Click="Save"/>
                    <CheckBox x:Name="CloseBrowsers" Content="{l:T 'Cerrar navegadores y programas automáticamente antes de limpiar'}" Margin="0,6,0,0" Click="Save"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Solo borrar archivos temporales con más de'}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TempAge" Width="120" Margin="8,0" SelectionChanged="TempAge_Changed">
                            <ComboBoxItem Content="{l:T '0 horas'}" Tag="0"/>
                            <ComboBoxItem Content="{l:T '24 horas'}" Tag="24"/>
                            <ComboBoxItem Content="{l:T '48 horas'}" Tag="48"/>
                            <ComboBoxItem Content="{l:T '7 días'}" Tag="168"/>
                        </ComboBox>
                        <TextBlock Text="{l:T 'de antigüedad'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Reglas de limpieza de la comunidad'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="{l:T 'Añade reglas para más de 2.000 programas y juegos, mantenidas por la comunidad Winapp2 (el mismo formato que usan CCleaner y BleachBit). Aparecen desmarcadas en Limpieza, solo para los programas que tienes instalados.'}"/>
                    <TextBlock x:Name="Winapp2Status" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button x:Name="Winapp2Btn" Content="{l:T 'Descargar reglas'}" Style="{DynamicResource AccentButtonStyle}" Click="Winapp2Download_Click"/>
                        <Button x:Name="Winapp2Remove" Content="{l:T 'Quitar reglas'}" Margin="6,0,0,0" Click="Winapp2Remove_Click"/>
                        <Button Content="{l:T 'Proyecto Winapp2'}" Margin="6,0,0,0" Click="Winapp2Project_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0"
                               Text="{l:T 'Winapp2.ini es obra del proyecto Winapp2 y se distribuye con licencia CC BY-SA 4.0. Se descarga directamente de su repositorio.'}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Cookies a conservar'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="{l:T 'Al limpiar cookies se conservarán las de estos sitios, para que no se cierre tu sesión en ellos. Con la lista vacía se borran todas.'}"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="210">
                            <DockPanel>
                                <Button Content="{l:T 'Añadir'}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="AddCookie_Click"/>
                                <TextBox x:Name="CookieBox" ToolTip="{l:T 'ejemplo.com'}"/>
                            </DockPanel>
                            <Button Content="{l:T 'Añadir sitios comunes'}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="CommonCookies_Click"/>
                            <Button Content="{l:T 'Elegir de mis navegadores…'}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="BrowserCookies_Click"/>
                            <Button Content="{l:T 'Quitar'}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="RemoveCookie_Click"/>
                        </StackPanel>
                        <ListBox x:Name="CookieList" Height="170" SelectionMode="Extended"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Automático'}" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Limpieza automática:'}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AutoCleanBox" Width="180" Margin="8,0" SelectionChanged="AutoClean_Changed">
                            <ComboBoxItem Content="{l:T 'Nunca'}" Tag="never"/>
                            <ComboBoxItem Content="{l:T 'Cada día'}" Tag="daily"/>
                            <ComboBoxItem Content="{l:T 'Cada semana'}" Tag="weekly"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="{l:T 'Limpia en segundo plano lo que tengas marcado en «Limpieza» (sin privacidad y omitiendo los programas abiertos). El historial se guarda en el registro de actividad.'}"/>
                    <CheckBox x:Name="TrayBox" Content="{l:T 'Mostrar el monitor en la bandeja al iniciar Windows (avisa cuando hay mucha basura)'}" Margin="0,10,0,0" Click="Tray_Click"/>
                    <CheckBox x:Name="AutoTraceBox" Content="{l:T 'Registrar automáticamente cada instalación'}" Margin="0,10,0,0" Click="AutoTrace_Click"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="26,2,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Cuando instales un programa, OpenSweep anota qué carpetas y claves del registro crea. Al desinstalarlo sabrá exactamente qué quitar. Usa el monitor de la bandeja.'}"/>
                    <CheckBox x:Name="BrowserCloseBox" Content="{l:T 'Limpiar cada navegador al cerrarlo'}" Margin="0,10,0,0" Click="BrowserClose_Click"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="26,2,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Al cerrar Chrome, Edge, Firefox u otro navegador, se limpia lo que tengas marcado para él en «Limpieza». Usa el monitor de la bandeja.'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{l:T 'Avisar a partir de'}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThresholdBox" Width="110" Margin="8,0" SelectionChanged="Threshold_Changed">
                            <ComboBoxItem Content="200 MB" Tag="200"/>
                            <ComboBoxItem Content="500 MB" Tag="500"/>
                            <ComboBoxItem Content="1 GB" Tag="1024"/>
                            <ComboBoxItem Content="5 GB" Tag="5120"/>
                        </ComboBox>
                        <TextBlock Text="{l:T 'de basura'}" VerticalAlignment="Center"/>
                        <Button Content="{l:T 'Ver registro de actividad'}" Margin="16,0,0,0" Click="Log_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="UpdatesBox" Content="{l:T 'Buscar versiones nuevas de OpenSweep al iniciar'}" Margin="0,10,0,0" Click="Save"/>
                    <StackPanel Orientation="Horizontal" Margin="26,6,0,0">
                        <Button x:Name="CheckNowBtn" Content="{l:T 'Buscar actualizaciones ahora'}" Click="CheckNow_Click"/>
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <CheckBox x:Name="ShellMenuBox" Content="{l:T 'Añadir OpenSweep al menú del clic derecho del Explorador'}" Margin="0,10,0,0" Click="ShellMenu_Click"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="26,2,0,0" TextWrapping="Wrap"
                               Text="{l:T '«Desinstalar con OpenSweep» en accesos directos y programas, y «Destruir con OpenSweep» en archivos y carpetas. En Windows 11 aparecen en «Mostrar más opciones».'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Tema:'}" VerticalAlignment="Center" Width="60"/>
                        <ComboBox x:Name="ThemeBox" Width="180" Margin="8,0" SelectionChanged="Theme_Changed">
                            <ComboBoxItem Content="{l:T 'Automático (como Windows)'}" Tag="auto"/>
                            <ComboBoxItem Content="{l:T 'Claro'}" Tag="light"/>
                            <ComboBoxItem Content="{l:T 'Oscuro'}" Tag="dark"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Idioma:'}" VerticalAlignment="Center" Width="60"/>
                        <ComboBox x:Name="LanguageBox" Width="180" Margin="8,0" SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="{l:T 'Automático'}" Tag="auto"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T '(se aplica al reiniciar OpenSweep)'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Seguridad'}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="RestorePoint" Content="{l:T 'Crear un punto de restauración del sistema antes de desinstalar'}" Click="Save"/>
                    <CheckBox x:Name="RegBackup" Content="{l:T 'Ofrecer copia de seguridad antes de reparar el registro'}" Margin="0,6,0,0" Click="Save"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Incluir carpetas personalizadas'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'El contenido de estas carpetas se borrará en la Limpieza (grupo «Personalizado»).'}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="{l:T 'Añadir'}" Click="AddInclude_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="{l:T 'Quitar'}" Margin="0,6,0,0" Click="RemoveInclude_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <ListBox x:Name="IncludeList" Height="90"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T 'Excluir (nunca borrar)'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Los archivos dentro de estas carpetas nunca se eliminarán durante la limpieza.'}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="{l:T 'Añadir'}" Click="AddExclude_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="{l:T 'Quitar'}" Margin="0,6,0,0" Click="RemoveExclude_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <ListBox x:Name="ExcludeList" Height="90"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Acerca de OpenSweep'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Limpiador, desinstalador y optimizador libre y de código abierto (licencia MIT).'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:T 'Proyecto en GitHub'}" Click="GitHub_Click"/>
                        <Button Content="{l:T 'Abrir copias de seguridad'}" Margin="6,0,0,0" Click="Backups_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
