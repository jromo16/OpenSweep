<UserControl x:Class="OpenSweep.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Opciones" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Los cambios se guardan automáticamente." Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Limpieza" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="SecureDelete" Content="Borrado seguro al limpiar (más lento: sobrescribe los archivos antes de eliminarlos)" Click="Save"/>
                    <CheckBox x:Name="CloseBrowsers" Content="Cerrar navegadores y programas automáticamente antes de limpiar" Margin="0,6,0,0" Click="Save"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Solo borrar archivos temporales con más de" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TempAge" Width="120" Margin="8,0" SelectionChanged="TempAge_Changed">
                            <ComboBoxItem Content="0 horas" Tag="0"/>
                            <ComboBoxItem Content="24 horas" Tag="24"/>
                            <ComboBoxItem Content="48 horas" Tag="48"/>
                            <ComboBoxItem Content="7 días" Tag="168"/>
                        </ComboBox>
                        <TextBlock Text="de antigüedad" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Cookies a conservar" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="Al limpiar cookies se conservarán las de estos sitios, para que no se cierre tu sesión en ellos. Con la lista vacía se borran todas."/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="210">
                            <DockPanel>
                                <Button Content="Añadir" DockPanel.Dock="Right" Margin="6,0,0,0" Click="AddCookie_Click"/>
                                <TextBox x:Name="CookieBox" ToolTip="ejemplo.com"/>
                            </DockPanel>
                            <Button Content="Añadir sitios comunes" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="CommonCookies_Click"/>
                            <Button Content="Elegir de mis navegadores…" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="BrowserCookies_Click"/>
                            <Button Content="Quitar" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="RemoveCookie_Click"/>
                        </StackPanel>
                        <ListBox x:Name="CookieList" Height="170" SelectionMode="Extended"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Automático" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Limpieza automática:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AutoCleanBox" Width="180" Margin="8,0" SelectionChanged="AutoClean_Changed">
                            <ComboBoxItem Content="Nunca" Tag="never"/>
                            <ComboBoxItem Content="Cada día" Tag="daily"/>
                            <ComboBoxItem Content="Cada semana" Tag="weekly"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Limpia en segundo plano lo que tengas marcado en «Limpieza» (sin privacidad y omitiendo los programas abiertos). El historial se guarda en el registro de actividad."/>
                    <CheckBox x:Name="TrayBox" Content="Mostrar el monitor en la bandeja al iniciar Windows (avisa cuando hay mucha basura)" Margin="0,10,0,0" Click="Tray_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Avisar a partir de" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThresholdBox" Width="110" Margin="8,0" SelectionChanged="Threshold_Changed">
                            <ComboBoxItem Content="200 MB" Tag="200"/>
                            <ComboBoxItem Content="500 MB" Tag="500"/>
                            <ComboBoxItem Content="1 GB" Tag="1024"/>
                            <ComboBoxItem Content="5 GB" Tag="5120"/>
                        </ComboBox>
                        <TextBlock Text="de basura" VerticalAlignment="Center"/>
                        <Button Content="Ver registro de actividad" Margin="16,0,0,0" Click="Log_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="UpdatesBox" Content="Buscar versiones nuevas de OpenSweep al iniciar" Margin="0,10,0,0" Click="Save"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Idioma:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LanguageBox" Width="180" Margin="8,0" SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="Automático" Tag="auto"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Muted}" Text="(se aplica al reiniciar OpenSweep)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Seguridad" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="RestorePoint" Content="Crear un punto de restauración del sistema antes de desinstalar" Click="Save"/>
                    <CheckBox x:Name="RegBackup" Content="Ofrecer copia de seguridad antes de reparar el registro" Margin="0,6,0,0" Click="Save"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Incluir carpetas personalizadas" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="El contenido de estas carpetas se borrará en la Limpieza (grupo «Personalizado»)." Margin="0,0,0,8"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="Añadir" Click="AddInclude_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="Quitar" Margin="0,6,0,0" Click="RemoveInclude_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <ListBox x:Name="IncludeList" Height="90"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Excluir (nunca borrar)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Los archivos dentro de estas carpetas nunca se eliminarán durante la limpieza." Margin="0,0,0,8"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="Añadir" Click="AddExclude_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="Quitar" Margin="0,6,0,0" Click="RemoveExclude_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <ListBox x:Name="ExcludeList" Height="90"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Acerca de OpenSweep" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Limpiador, desinstalador y optimizador libre y de código abierto (licencia MIT)."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Proyecto en GitHub" Click="GitHub_Click"/>
                        <Button Content="Abrir copias de seguridad" Margin="6,0,0,0" Click="Backups_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
