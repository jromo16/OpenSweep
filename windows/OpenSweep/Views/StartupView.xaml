<UserControl x:Class="OpenSweep.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Inicio de Windows" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Controla qué programas y tareas se ejecutan al encender el equipo. Deshabilitar es reversible; eliminar no." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ShowTasks" Content="Incluir tareas programadas" Margin="0,0,16,0" Click="Refresh_Click"/>
                <CheckBox x:Name="ShowMsTasks" Content="Incluir tareas de Microsoft" Click="Refresh_Click"/>
            </StackPanel>
            <Button Content="Actualizar" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abrir ubicación" Click="OpenLocation_Click"/>
                <Button Content="Eliminar" Margin="6,0,0,0" Click="Delete_Click"/>
                <Button Content="Deshabilitar" Margin="6,0,0,0" Click="Disable_Click"/>
                <Button Content="Habilitar" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Enable_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="EntriesGrid" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="110"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="160"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="130"/>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
