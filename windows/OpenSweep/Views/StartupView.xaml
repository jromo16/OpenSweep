<UserControl x:Class="OpenSweep.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Inicio de Windows'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Controla qué programas y tareas se ejecutan al encender el equipo. Deshabilitar es reversible; eliminar no.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ShowTasks" Content="{l:T 'Incluir tareas programadas'}" Margin="0,0,16,0" Click="Refresh_Click"/>
                <CheckBox x:Name="ShowMsTasks" Content="{l:T 'Incluir tareas de Microsoft'}" Click="Refresh_Click"/>
            </StackPanel>
            <Button Content="{l:T 'Actualizar'}" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{l:T 'Abrir ubicación'}" Click="OpenLocation_Click"/>
                <Button Content="{l:T 'Eliminar'}" Margin="6,0,0,0" Click="Delete_Click"/>
                <Button Content="{l:T 'Deshabilitar'}" Margin="6,0,0,0" Click="Disable_Click"/>
                <Button Content="{l:T 'Habilitar'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Enable_Click"/>
            </WrapPanel>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="EntriesGrid" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Estado'}" Binding="{Binding StateText}" Width="110"/>
                    <DataGridTextColumn Header="{l:T 'Nombre'}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{l:T 'Fabricante'}" Binding="{Binding Publisher}" Width="160"/>
                    <DataGridTextColumn Header="{l:T 'Tipo'}" Binding="{Binding KindText}" Width="130"/>
                    <DataGridTextColumn Header="{l:T 'Ubicación'}" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="{l:T 'Comando'}" Binding="{Binding Command}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
