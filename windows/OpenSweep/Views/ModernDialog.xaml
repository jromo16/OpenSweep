<Window x:Class="OpenSweep.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="470" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Title="OpenSweep">
    <!-- Diálogo moderno: tarjeta redondeada con sombra, icono de color y botones a la derecha -->
    <Border Margin="18" CornerRadius="14" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Direction="270"/>
        </Border.Effect>
        <StackPanel Margin="26,24,26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Icono -->
                <Border x:Name="IconCircle" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,6,0,0"/>
                    <!-- Progreso -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <ProgressBar x:Name="Bar" Height="6" Maximum="100"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
        </StackPanel>
    </Border>
</Window>
