<Window x:Class="OpenSweep.Views.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenSweep.Core"
        xmlns:s="clr-namespace:OpenSweep.Services"
        Title="{l:T 'Desinstalar'}" Height="640" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource ContentBrush}">
    <Window.Resources>
        <!-- Árbol de restos: casilla de tres estados, icono, nombre y detalle -->
        <HierarchicalDataTemplate x:Key="NodeTemplate" DataType="{x:Type s:LeftoverNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="NodeText" Text="{Binding Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="NodeDetail" Text="{Binding Detail}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Item}" Value="{x:Null}">
                    <Setter TargetName="NodeText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="NodeDetail" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="LeftoverTree" TargetType="TreeView">
            <Setter Property="ItemTemplate" Value="{StaticResource NodeTemplate}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="12" Padding="16,14" Margin="0,0,10,0" BorderThickness="2"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecera: título del paso y progreso del asistente -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="StepsText" FontSize="12" Foreground="#E6FFFFFF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Botones del asistente -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="BackBtn" Content="{l:T 'Atrás'}" Click="Back_Click"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Click="Cancel_Click"/>
                    <Button x:Name="NextBtn" Content="{l:T 'Siguiente'}" Padding="22,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Next_Click"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24,18,24,12">
            <!-- 1. Trabajando: punto de restauración, desinstalador, análisis -->
            <StackPanel x:Name="PageWork" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="WorkText" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="WorkSub" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ProgressBar IsIndeterminate="True" Height="4" Width="320" Margin="0,18,0,0"/>
            </StackPanel>

            <!-- 2. Modo de análisis -->
            <StackPanel x:Name="PageMode" Visibility="Collapsed">
                <TextBlock x:Name="ModeIntro" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="StillInstalledText" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                           Text="{l:T 'El programa sigue instalado (puede que el desinstalador se cancelara). Se buscarán sus restos igualmente; revisa bien la lista.'}"/>
                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <RadioButton x:Name="ModeSafe" GroupName="mode" Style="{StaticResource ModeCard}" Checked="Mode_Changed">
                        <StackPanel>
                            <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{l:T 'Seguro'}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeModerate" GroupName="mode" Style="{StaticResource ModeCard}" IsChecked="True" Checked="Mode_Changed">
                        <StackPanel>
                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{l:T 'Moderado (recomendado)'}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeAdvanced" GroupName="mode" Style="{StaticResource ModeCard}" Checked="Mode_Changed">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{l:T 'Avanzado'}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <TextBlock x:Name="ModeDescription" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- 3. Registro y 4. Archivos -->
            <DockPanel x:Name="PageTree" Visibility="Collapsed">
                <TextBlock x:Name="TreeIntro" DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T 'Marcar todo'}" Click="CheckAll_Click"/>
                        <Button Content="{l:T 'Desmarcar todo'}" Margin="6,0,0,0" Click="UncheckAll_Click"/>
                        <Button x:Name="DeleteBtn" Content="{l:T 'Eliminar marcados'}" Margin="6,0,0,0" Style="{DynamicResource DangerButtonStyle}" Click="Delete_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TreeCounts" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <TreeView x:Name="Tree" Style="{StaticResource LeftoverTree}"/>
                        <TextBlock x:Name="TreeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 5. Resumen -->
            <ScrollViewer x:Name="PageSummary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SummaryTitle" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel x:Name="SummaryLines"/>
                    </Border>
                    <TextBlock x:Name="SummaryBackup" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Expander x:Name="DetailsExpander" Header="{l:T 'Ver detalles'}" Margin="0,12,0,0">
                        <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="220" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
