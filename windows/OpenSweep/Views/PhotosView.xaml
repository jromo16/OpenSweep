<UserControl x:Class="OpenSweep.Views.PhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <UserControl.Resources>
        <!-- Tarjeta de una foto o vídeo -->
        <DataTemplate x:Key="Tile">
            <Border Width="164" Margin="0,0,10,10" CornerRadius="8" Background="#262C34" Padding="6"
                    BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Height="120" Background="#1A1E24">
                        <Image Source="{Binding Thumb, IsAsync=True}" Stretch="Uniform" MouseLeftButtonDown="Thumb_Click" Cursor="Hand"
                               ToolTip="{Binding Path}"/>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0"
                                  Click="Check_Click"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Background="{StaticResource AccentBrush}"
                                CornerRadius="4" Padding="6,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{l:T 'Mejor'}" Foreground="Black" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{l:T '&#xE714;'}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Grupo: título + fotos en filas -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Margin="0,0,0,8">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Tile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Fotos y vídeos'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Encuentra fotos parecidas (ráfagas, copias redimensionadas o reenviadas por WhatsApp), fotos borrosas u oscuras, capturas de pantalla antiguas y vídeos repetidos. Se marca para conservar la de mejor calidad de cada grupo.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top">
                            <Button Content="{l:T 'Añadir carpeta'}" Click="AddFolder_Click"/>
                            <Button Content="{l:T 'Quitar'}" Margin="6,0,0,0" Click="RemoveFolder_Click"/>
                        </StackPanel>
                        <ListBox x:Name="FoldersList" Height="96"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Parecido:'}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThresholdBox" Width="270" Margin="8,0,0,0" SelectedIndex="1">
                            <ComboBoxItem Content="{l:T 'Casi idénticas'}" Tag="3"/>
                            <ComboBoxItem Content="{l:T 'Muy parecidas (recomendado)'}" Tag="6"/>
                            <ComboBoxItem Content="{l:T 'Parecidas'}" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="ScanBtn" Content="{l:T 'Analizar'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Scan_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T 'Desmarcar todo'}" Click="Uncheck_Click"/>
                <Button x:Name="DeleteBtn" Content="{l:T 'Enviar marcados a la papelera'}" Padding="20,6" Margin="6,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>
        <ProgressBar x:Name="Bar" DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,0,0,6"/>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="TabSimilar" Header="{l:T 'Fotos similares'}"/>
            <TabItem x:Name="TabVideos" Header="{l:T 'Vídeos similares'}"/>
            <TabItem x:Name="TabBlurry" Header="{l:T 'Borrosas'}"/>
            <TabItem x:Name="TabDark" Header="{l:T 'Oscuras'}"/>
            <TabItem x:Name="TabShots" Header="{l:T 'Capturas de pantalla'}"/>
        </TabControl>
    </DockPanel>
</UserControl>
