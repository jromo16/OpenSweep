<UserControl x:Class="OpenSweep.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Buscador de archivos duplicados'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Encuentra archivos idénticos comparando su contenido (SHA-256). Por defecto se conserva la copia más antigua de cada grupo.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="6,0,0,0">
                            <Button Content="{l:T 'Añadir carpeta'}" Click="AddFolder_Click"/>
                            <Button Content="{l:T 'Quitar'}" Margin="6,0,0,0" Click="RemoveFolder_Click"/>
                        </StackPanel>
                        <ListBox x:Name="FoldersList" Height="70"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Tamaño mínimo:'}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MinSizeBox" Width="110" Margin="8,0,16,0" SelectedIndex="1">
                            <ComboBoxItem Content="1 KB" Tag="1024"/>
                            <ComboBoxItem Content="100 KB" Tag="102400"/>
                            <ComboBoxItem Content="1 MB" Tag="1048576"/>
                            <ComboBoxItem Content="10 MB" Tag="10485760"/>
                            <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        </ComboBox>
                        <CheckBox x:Name="MatchName" Content="{l:T 'Exigir mismo nombre'}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="SearchBtn" Content="{l:T 'Buscar'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Search_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{l:T 'Abrir ubicación'}" Click="Open_Click"/>
                <Button Content="{l:T 'Desmarcar todo'}" Margin="6,0,0,0" Click="Uncheck_Click"/>
                <Button Content="{l:T 'Eliminar marcados'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Delete_Click"/>
            </WrapPanel>
        </DockPanel>
        <DataGrid x:Name="DupGrid" RowHeight="56" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="52"
                                        ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}"/>
                <DataGridTextColumn Header="{l:T 'Grupo'}" Binding="{Binding Group}" Width="60" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="{l:T 'Vista'}" Width="70" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Thumb, IsAsync=True}" Height="48" Width="60" Stretch="Uniform" ToolTip="{Binding Path}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T 'Nombre'}" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{l:T 'Tamaño'}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="{l:T 'Modificado'}" Binding="{Binding DateText}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="{l:T 'Carpeta'}" Binding="{Binding Folder}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
