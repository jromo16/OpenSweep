<UserControl x:Class="OpenSweep.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Analizador de disco'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Descubre qué tipos de archivos y qué carpetas ocupan más espacio.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="AnalyzeBtn" Content="{l:T 'Analizar'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Analyze_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="DriveBox" Width="180"/>
                <Button Content="{l:T 'Elegir carpeta...'}" Margin="6,0,0,0" Click="Browse_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Grid.RowSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Por tipo de archivo'}" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="CategoriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Count, StringFormat=' ({0:N0})', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T 'Carpetas principales'}" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="FoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <DockPanel Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="{l:T 'Archivos más grandes'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{l:T 'Abrir ubicación'}" Click="Open_Click"/>
                    <Button Content="{l:T 'Enviar a la papelera'}" Margin="6,0,0,0" Click="Delete_Click"/>
                </WrapPanel>
            </DockPanel>
            <DataGrid x:Name="FilesGrid" Grid.Column="2" Grid.Row="1" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Nombre'}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{l:T 'Tamaño'}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90"/>
                    <DataGridTextColumn Header="{l:T 'Tipo'}" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="{l:T 'Modificado'}" Binding="{Binding DateText}" SortMemberPath="Modified" Width="130"/>
                    <DataGridTextColumn Header="{l:T 'Carpeta'}" Binding="{Binding Folder}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
