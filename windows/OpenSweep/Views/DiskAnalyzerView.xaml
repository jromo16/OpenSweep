<UserControl x:Class="OpenSweep.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenSweep.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Analizador de disco'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Descubre qué tipos de archivos y qué carpetas ocupan más espacio.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelBtn" Content="{l:T 'Cancelar'}" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="AnalyzeBtn" Content="{l:T 'Analizar'}" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Analyze_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="DriveBox" Width="180"/>
                <Button Content="{l:T 'Elegir carpeta...'}" Margin="6,0,0,0" Click="Browse_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Grid.RowSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Por tipo de archivo'}" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="CategoriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Count, StringFormat=' ({0:N0})', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T 'Carpetas principales'}" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="FoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TabControl Grid.Column="2" Grid.RowSpan="2">
                <!-- Mapa visual: cada rectángulo es una carpeta, de tamaño proporcional a lo que ocupa -->
                <TabItem Header="{l:T 'Mapa'}">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="UpBtn" Content="{l:T '↑ Subir'}" IsEnabled="False" Click="Up_Click"/>
                            <Button Content="{l:T 'Abrir en el Explorador'}" Margin="6,0,0,0" DockPanel.Dock="Right" Click="OpenMapFolder_Click"/>
                            <TextBlock x:Name="MapPath" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Text="{l:T 'Doble clic en una carpeta para entrar. Clic derecho para abrirla en el Explorador.'}"/>
                        <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Canvas x:Name="MapCanvas" SizeChanged="MapCanvas_SizeChanged" ClipToBounds="True"/>
                                <TextBlock x:Name="MapEmpty" Text="{l:T 'Pulsa «Analizar» para ver el mapa del disco.'}" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{l:T 'Archivos más grandes'}">
                    <DockPanel Margin="0,10,0,0">
                        <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="{l:T 'Abrir ubicación'}" Click="Open_Click"/>
                            <Button Content="{l:T 'Enviar a la papelera'}" Margin="6,0,0,0" Click="Delete_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="FilesGrid" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Nombre'}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{l:T 'Tamaño'}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90"/>
                                <DataGridTextColumn Header="{l:T 'Tipo'}" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="{l:T 'Modificado'}" Binding="{Binding DateText}" SortMemberPath="Modified" Width="130"/>
                                <DataGridTextColumn Header="{l:T 'Carpeta'}" Binding="{Binding Folder}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
