<UserControl x:Class="OpenSweep.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Analizador de disco" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Descubre qué tipos de archivos y qué carpetas ocupan más espacio." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelBtn" Content="Cancelar" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="AnalyzeBtn" Content="Analizar" Padding="20,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Analyze_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="DriveBox" Width="180"/>
                <Button Content="Elegir carpeta..." Margin="6,0,0,0" Click="Browse_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Grid.RowSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Por tipo de archivo" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="CategoriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Count, StringFormat=' ({0:N0})', Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Carpetas principales" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="FoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <DockPanel Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="Archivos más grandes" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abrir ubicación" Click="Open_Click"/>
                    <Button Content="Enviar a la papelera" Margin="6,0,0,0" Click="Delete_Click"/>
                </StackPanel>
            </DockPanel>
            <DataGrid x:Name="FilesGrid" Grid.Column="2" Grid.Row="1" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Modificado" Binding="{Binding DateText}" SortMemberPath="Modified" Width="130"/>
                    <DataGridTextColumn Header="Carpeta" Binding="{Binding Folder}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
